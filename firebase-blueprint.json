  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "Client" },
      "description": "Clientes da central de suporte"
    },
    "/stores/{storeId}": {
      "schema": { "$ref": "Store" },
      "description": "Lojas e unidades operacionais"
    },
    "/branches/{branchId}": {
      "schema": { "$ref": "BranchUnit" },
      "description": "Matrizes e filiais da rede Mark Security"
    },
    "/equipments/{equipmentId}": {
      "schema": { "$ref": "Equipment" },
      "description": "Parque de máquinas, PDVs e servidores com patrimônio"
    },
    "/service_orders/{orderId}": {
      "schema": { "$ref": "ServiceOrder" },
      "description": "Ordens de serviço operacionais e chamados técnicos"
    },
    "/movements/{movementId}": {
      "schema": { "$ref": "MovementRecord" },
      "description": "Movimentações de entrada e retirada de máquinas"
    },
    "/hardware_changes/{changeId}": {
      "schema": { "$ref": "HardwareChangeRecord" },
      "description": "Substituições e trocas de componentes físicos"
    },
    "/branch_checklists/{chkId}": {
      "schema": { "$ref": "BranchChecklist" },
      "description": "Checklists operacionais executados nas lojas"
    },
    "/checklist_templates/{templateId}": {
      "schema": { "$ref": "ChecklistTemplate" },
      "description": "Modelos reutilizáveis de checklist"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Trilha imutável de auditoria e governança"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Contas de usuários e credenciais individuais"
    },
    "/knowledge_articles/{artId}": {
      "schema": { "$ref": "KnowledgeArticle" },
      "description": "Artigos técnicos e manuais operacionais"
    },
    "/remote_access/{accessId}": {
      "schema": { "$ref": "RemoteAccess" },
      "description": "Identificadores AnyDesk e TeamViewer de máquinas por loja"
    },
    "/remote_access_history/{histId}": {
      "schema": { "$ref": "RemoteAccessHistory" },
      "description": "Histórico cronológico de acessos remotos e formatações"
    },
    "/machine_patrimony_history/{histId}": {
      "schema": { "$ref": "MachinePatrimonyHistory" },
      "description": "Histórico completo de intervenções e alterações da máquina"
    },
    "/maintenance_queue/{queueId}": {
      "schema": { "$ref": "MaintenanceRecord" },
      "description": "Fila técnica de manutenção em laboratório integrada às Ordens de Serviço"
    },
    "/daily_demands/{demandId}": {
      "schema": { "$ref": "DailyDemand" },
      "description": "Demandas e chamados operacionais do dia a dia (Vivo, acessos, provedores)"
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "SystemConfig" },
      "description": "Configurações e controle de estado do sistema"
    }
  }
}
