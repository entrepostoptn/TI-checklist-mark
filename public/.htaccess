# ==============================================================================
# Configuração para Hostinger / Apache / LiteSpeed (SPA React Produção)
# ==============================================================================

DirectoryIndex index.html
Options -Indexes +FollowSymLinks

# SPA Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Controle RÍGIDO de Cache (Garante que novas atualizações subam imediatamente)
<IfModule mod_headers.c>
  # NUNCA armazenar em cache páginas HTML, Service Worker ou Manifest
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "(sw\.js|service-worker\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Arquivos com hash na pasta assets podem ter cache longo e seguro (1 ano)
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Tipos MIME
<IfModule mod_mime.c>
  AddType image/x-icon ico
  AddType image/svg+xml svg svgz
  AddType application/javascript js mjs
  AddType text/css css
  AddType application/json json
  AddType application/manifest+json webmanifest
  AddType font/woff woff
  AddType font/woff2 woff2
</IfModule>

# Compressão Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
