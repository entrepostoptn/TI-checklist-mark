# ----------------------------------------------------------------------
# Configuração para Hostinger / Apache / LiteSpeed (SPA React)
# ----------------------------------------------------------------------

# 1. Definir arquivos de índice
DirectoryIndex index.html

# 2. Desabilitar listagem de diretório
Options -Indexes +FollowSymLinks

# 3. Reescrever requisições para a pasta dist se ela existir no repositório
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Favicon e manifest direto
  RewriteRule ^favicon\.ico$ - [L]
  RewriteRule ^favicon\.svg$ - [L]
  RewriteRule ^manifest\.json$ - [L]

  # Se a pasta dist/ existir no servidor e a requisição NÃO for para dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^$ dist/index.html [L]

  # Redirecionar arquivos existentes dentro de dist (assets, favicon, manifest, etc.)
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # SPA Fallback: Qualquer rota inexistente vai para dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^(.*)$ dist/index.html [L]

  # Se dist/ não existir (ex: raiz direta), aplica as regras padrão
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . index.html [L]
</IfModule>

# 4. Tipos MIME para arquivos estáticos
<IfModule mod_mime.c>
  AddType image/x-icon ico
  AddType image/svg+xml svg svgz
  AddType application/javascript js mjs
  AddType text/css css
  AddType application/json json
  AddType application/manifest+json webmanifest
</IfModule>

# 5. Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Headers de segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
