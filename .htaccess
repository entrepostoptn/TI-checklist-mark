# ----------------------------------------------------------------------
# Configuração para Hostinger / Apache / LiteSpeed (SPA React)
# ----------------------------------------------------------------------

# 1. Definir arquivos de índice padrão
DirectoryIndex index.html

# 2. Desabilitar listagem de diretório
Options -Indexes +FollowSymLinks

# 3. Reescrever requisições para a pasta dist se ela existir no repositório
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Favicon, assets e manifest diretos
  RewriteRule ^favicon\.ico$ - [L]
  RewriteRule ^favicon\.svg$ - [L]
  RewriteRule ^manifest\.json$ - [L]

  # Se o arquivo ou diretório solicitado existir fisicamente na raiz, serve direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Se existir dentro da pasta dist, reescreve internamente para dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond dist/$1 -f [OR]
  RewriteCond dist/$1 -d
  RewriteRule ^(.*)$ dist/$1 [L]

  # SPA Fallback: Se a pasta dist existir, serve dist/index.html
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond dist/index.html -f
  RewriteRule ^ dist/index.html [L]

  # SPA Fallback padrão na raiz
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Tipos MIME para arquivos estáticos modernos
<IfModule mod_mime.c>
  AddType image/x-icon ico
  AddType image/svg+xml svg svgz
  AddType application/javascript js mjs
  AddType text/css css
  AddType application/json json
  AddType application/manifest+json webmanifest
</IfModule>

# 5. Compressão Gzip/Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Headers de segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
